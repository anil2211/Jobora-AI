# Extension build-time environment variables (Vite)

# Backend API base URL.
# - Development (npm run dev): defaults to http://localhost:5000
# - Production build (npm run build): defaults to https://jobora-ai.onrender.com
# Override either one by setting this variable, e.g.:
# VITE_API_URL=https://jobora-ai.onrender.com
VITE_API_URL=https://jobora-ai.onrender.com
