{
  "manifest_version": 3,
  "name": "AI Job Saver",
  "version": "1.0",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "identity",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:5000/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "action": {
    "default_title": "Open AI Job Saver"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "./content.js"
      ]
    }
  ],
  "oauth2": {
    "client_id": "782667921374-el3v12c3nnnre060fasfpmdd9eleeiuk.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/spreadsheets",
      "https://www.googleapis.com/auth/drive.file"
    ]
  }
}
