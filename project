3. Create OpenAI Service

Create:

backend/src/openai.js

Add:

import OpenAI from "openai";


const client = new OpenAI({
    apiKey: process.env.OPENAI_API_KEY
});


export async function extractJob(text){


const response =
await client.chat.completions.create({

model:"gpt-4.1-mini",

messages:[

{
role:"system",
content:
`
You extract job information from webpages.

Return ONLY valid JSON.

Schema:

{
"title":"",
"company":"",
"location":"",
"salary":"",
"employmentType":"",
"experience":"",
"skills":[],
"description":"",
"source":""
}
`
},

{
role:"user",
content:text.substring(0,12000)
}

],

temperature:0.2

});


return JSON.parse(
response.choices[0]
.message
.content
);


}
