6. Create Authentication Service

Create:

backend/src/auth.js

Add:

import {OAuth2Client}
from "google-auth-library";

import jwt from "jsonwebtoken";


const client =
new OAuth2Client(
process.env.GOOGLE_CLIENT_ID
);



export async function verifyGoogleToken(token){


const ticket =
await client.verifyIdToken({

idToken:token,

audience:
process.env.GOOGLE_CLIENT_ID

});


return ticket.getPayload();

}



export function createJWT(user){


return jwt.sign(

{
id:user.id,
email:user.email
},

process.env.JWT_SECRET,

{
expiresIn:"7d"
}

);

}
7. Create Auth Route

Create:

backend/src/routes/auth.js

Code:

import express from "express";

import {
supabase
}
from "../supabase.js";

import {
verifyGoogleToken,
createJWT
}
from "../auth.js";


const router =
express.Router();



router.post(
"/google",

async(req,res)=>{


try{


const {
token
}=req.body;



const googleUser =
await verifyGoogleToken(token);



let {
data:user
}
=
await supabase

.from("users")

.select("*")

.eq(
"google_id",
googleUser.sub
)

.single();



if(!user){


const result =
await supabase

.from("users")

.insert({

google_id:
googleUser.sub,

email:
googleUser.email,

name:
googleUser.name,

avatar:
googleUser.picture

})

.select()
.single();



user=result.data;


}



const jwtToken =
createJWT(user);



res.json({

token:jwtToken,

user

});


}

catch(error){

res.status(401)
.json({
error:"Authentication failed"
});

}


});


export default router;
